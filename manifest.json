{
  "manifest_version": 3,
  "name": "纯黑浏览 · Pure Black",
  "version": "1.8.0",
  "description": "自定义网页背景色与黑色程度，提供一键预设、文字对比度适配和网站开关。",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "toggle-pure-black": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "开启 / 关闭纯黑浏览（全部网站）"
    }
  },
  "icons": { "16": "icons/awake-16.png", "32": "icons/awake-32.png", "48": "icons/awake-48.png", "128": "icons/awake-128.png" },
  "action": { "default_title": "纯黑浏览", "default_popup": "popup.html", "default_icon": { "16": "icons/awake-16.png", "32": "icons/awake-32.png", "48": "icons/awake-48.png", "128": "icons/awake-128.png" } },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["theme.js", "lamp.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
